# Salin ke .env untuk development lokal.
# Untuk deploy, isi di pengaturan build Cloudflare Workers (dibaca saat build).
NUXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Opsional: email undangan buku lewat Resend (domain pengirim harus terverifikasi).
# Di Cloudflare Workers isi sebagai secret: wrangler secret put NUXT_RESEND_API_KEY
# Kosong = undangan tetap dibuat, link dibagikan manual.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=Money Manager <noreply@ikrm.dev>

# Opsional: baca foto struk/screenshot lewat Claude API (fase 11).
# Di Cloudflare Workers isi sebagai secret: wrangler secret put NUXT_ANTHROPIC_API_KEY
# Kosong = tombol baca foto menampilkan pesan bahwa fitur belum aktif.
NUXT_ANTHROPIC_API_KEY=
NUXT_OCR_MODEL=claude-haiku-5-5
NUXT_OCR_DAILY_LIMIT=30
