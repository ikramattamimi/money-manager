// Deploy ke Cloudflare Workers: aset statis + server route Nitro dalam satu Worker.
// `pnpm run deploy` = build lalu `wrangler deploy` (login sekali: `npx wrangler login`).
// NUXT_PUBLIC_SUPABASE_URL dan NUXT_PUBLIC_SUPABASE_ANON_KEY dibaca saat build:
// isi di .env atau di pengaturan build Workers Builds, bukan di sini.
// Secret server (NUXT_ANTHROPIC_API_KEY, NUXT_RESEND_API_KEY) diisi lewat
// `wrangler secret put <NAMA>`; panduan lengkap di README.md bagian Deploy.
{
  "name": "money-manager",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "NUXT_OCR_DAILY_LIMIT": "30",
    "NUXT_OCR_MODEL": "claude-haiku-5-5",
    "NUXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_W0a0QC5GUHKk6lHIjnBxtg_js5Ew7j9",
    "NUXT_PUBLIC_SUPABASE_URL": "https://setdjlttwahdajvmzkyo.supabase.co"
  }
}
